# Сайт работает без ключа: встроенная модель отвечает сама.
# Основная модель — Google Gemini. Бесплатный ключ: https://aistudio.google.com/ → Get API key.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash   (по желанию: другая модель Gemini)
# GEMINI_RPD=                     (по желанию: ваш дневной лимит запросов из AI Studio — для индикатора)

# Запасная модель — llm7.io: сайт переходит на неё сам, если у Gemini кончился лимит.
# Без токена лимит llm7.io — ~10 запросов в минуту и 60 в час на IP (на Vercel IP общие).
# Бесплатный токен: https://dash.llm7.io → поднимает лимит. Вставьте его сюда:
# LLM7_TOKEN=

# Раскомментируйте строки ниже, только если нужна своя модель.

# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

PORT=3000

# Railway / Vercel: задайте те же переменные в панели проекта.
# GitHub Pages: после деплоя укажите URL в docs/config.json → apiBase (см. DEPLOY.md).
